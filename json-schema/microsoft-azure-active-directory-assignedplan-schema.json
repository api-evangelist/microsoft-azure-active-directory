{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/AssignedPlan",
  "title": "AssignedPlan",
  "type": "object",
  "description": "Represents a plan assigned to a user.",
  "properties": {
    "assignedDateTime": {
      "type": "string",
      "format": "date-time",
      "example": "2026-01-15T10:30:00Z"
    },
    "capabilityStatus": {
      "type": "string",
      "enum": [
        "Enabled",
        "Warning",
        "Suspended",
        "Deleted",
        "LockedOut"
      ],
      "example": "Enabled"
    },
    "service": {
      "type": "string",
      "example": "example_value"
    },
    "servicePlanId": {
      "type": "string",
      "format": "uuid",
      "example": "500123"
    }
  }
}