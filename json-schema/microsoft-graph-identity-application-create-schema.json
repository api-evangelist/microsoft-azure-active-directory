      "type": "string",
      "description": "The display name for the application."
    },
    "description": {
      "type": "string"
    },
    "signInAudience": {
      "type": "string"
    },
    "identifierUris": {
      "type": "array"
    },
    "appRoles": {
      "type": "array"
    },
    "requiredResourceAccess": {
      "type": "array"
    },
    "tags": {
      "type": "array"
    }
  }
}